<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- MediaTek's performance-lock library, which PdDecodeProbe holds to measure what the
             Neuron backend's old lifetime lock did to a CPU decode. From API 31 an app cannot
             load a vendor public library its manifest does not name, and the probe must still
             run on phones that have none, hence required="false". -->
        <uses-native-library
            android:name="libapuwareutils_v2.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwareutils.mtk.so"
            android:required="false" />
        <!-- The rest of the app's list (app/src/main/AndroidManifest.xml), so
             DisaggregatedOnDeviceTest can reach the NPU from this APK: without the adapter
             named here the Neuron backend is refused with "not accessible for the namespace
             clns-N" and the test sees no NPU at all. -->
        <uses-native-library
            android:name="libneuronusdk_adapter.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwareapusys_v2.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwareapusys.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwarexrp_v2.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwarexrp.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwarehmp.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libapuwareaiste.mtk.so"
            android:required="false" />
        <uses-native-library
            android:name="libneuron_sys_util.mtk.so"
            android:required="false" />

        <!-- Holds the foreground while PdDecodeProbe runs: the boost it measures was applied
             only to the top app, so an instrumentation process with nothing on screen would
             measure a different phone state. -->
        <activity
            android:name="io.github.alpharomercoma.openweights.core.engine.eval.ProbeActivity"
            android:exported="false" />
    </application>
</manifest>
