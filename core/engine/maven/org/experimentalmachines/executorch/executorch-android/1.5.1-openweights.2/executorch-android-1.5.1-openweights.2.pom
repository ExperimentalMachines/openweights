  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.experimentalmachines.executorch</groupId>
  <artifactId>executorch-android</artifactId>
  <version>1.5.1-openweights.2</version>
  <packaging>aar</packaging>
  <name>ExecuTorch Android</name>
  <description>ExecuTorch Android API</description>
  <url>https://github.com/pytorch/executorch/</url>
  <inceptionYear>2025</inceptionYear>
  <licenses>
    <license>
      <name>BSD 3-Clause</name>
      <url>https://github.com/pytorch/executorch/blob/main/LICENSE</url>
      <distribution>https://github.com/pytorch/executorch/blob/main/LICENSE</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>pytorch</id>
      <name>pytorch</name>
      <url>https://github.com/pytorch/executorch/</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/pytorch/executorch</connection>
    <developerConnection>scm:git:git@github.com:pytorch/executorch.git</developerConnection>
    <url>https://github.com/pytorch/executorch.git</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
