+    // Unset or 0, the wait is the plain spin it has always been.
+    static int yield_spins = -1;
+    if (yield_spins < 0) {
+        const char * e = getenv("GGML_BARRIER_YIELD_SPINS");
+        yield_spins = e ? atoi(e) : 0;
+    }
+    int spins = 0;
     while (atomic_load_explicit(&tp->n_barrier_passed, memory_order_relaxed) == n_passed) {
-        ggml_thread_cpu_relax();
+        if (yield_spins > 0 && ++spins >= yield_spins) {
+            sched_yield();
+        } else {
+            ggml_thread_cpu_relax();
+        }
     }
 
     // exit barrier (full seq-cst fence)
