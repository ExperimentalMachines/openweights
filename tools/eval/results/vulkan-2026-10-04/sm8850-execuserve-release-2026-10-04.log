##############################################################################
# greedy questions
##############################################################################
$ KEY=$(cat ~/.config/execuserve/4816891.key)
cat > $SCRATCH/q.sh <<EOF
H="Authorization: Bearer $KEY"
for q in "What is the capital of Japan? Answer in one word." "What is 17 times 3? Answer with the number only." "Name the largest planet in our solar system in one word."; do
  curl -s -m 120 -H "\$H" -H 'Content-Type: application/json' http://127.0.0.1:8080/v1/chat/completions -d "{\"model\":\"qwen3-0.6b-vulkan-8da4w-2k\",\"temperature\":0,\"max_tokens\":200,\"messages\":[{\"role\":\"user\",\"content\":\"\$q /no_think\"}]}"
  echo
done
curl -s -N -m 120 -H "\$H" -H 'Content-Type: application/json' http://127.0.0.1:8080/v1/chat/completions -d '{"model":"qwen3-0.6b-vulkan-8da4w-2k","stream":true,"temperature":0,"max_tokens":40,"messages":[{"role":"user","content":"Count from 1 to 5. /no_think"}]}' | grep -c '^data:'
curl -s -H "\$H" http://127.0.0.1:8080/v1/execuserve/status
EOF
adb push $SCRATCH/q.sh /data/local/tmp/es-q.sh >/dev/null && adb shell sh /data/local/tmp/es-q.sh | python3 -c "
import sys,json
for line in sys.stdin:
    line=line.strip()
    if not line: continue
    try: d=json.loads(line)
    except: print('stream chunks:', line); continue
    if 'choices' in d: print(repr(d['choices'][0]['message']['content'].strip()[:80]), d.get('usage',{}).get('completion_tokens'))
    elif 'totals' in d: print('totals', {k:d['totals'][k] for k in ('completed','failed')}, 'metrics', {k:v for k,v in d.items() if 'tok' in k.lower() or 'rate' in k.lower()})
    else: print(line[:300])
"; adb shell rm /data/local/tmp/es-q.sh

