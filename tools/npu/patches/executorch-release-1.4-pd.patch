+void LlamaModelChunk::UpdateConvInputs() {
+  if (!mHasConvInputs) {
+    return;
+  }
+  // Real tokens are [left, t - right). A conv mixes neighbouring positions and has no mask,
+  // so the pads are zeroed before it (valid), and the next state is taken at the last real
+  // positions (select), which on a right-padded batch are not the batch's last positions.
+  const size_t t = mTokenBatchSize;
+  const size_t left = GetLeftPadding();
+  const size_t right = GetRightPadding();
+  const auto method_meta = GetModelMethod().method_meta();
+  const auto validIdx = getInputIndex(IOKind::ConvValid);
+  const auto selectIdx = getInputIndex(IOKind::ConvSelect);
+  const auto selectSizes = method_meta.input_tensor_meta(selectIdx)->sizes();
+  const size_t rows = static_cast<size_t>(selectSizes[1]);
+  const size_t cols = static_cast<size_t>(selectSizes[2]);
+  ET_CHECK_MSG(rows == t + cols, "Conv select input is %zu rows for a %zu-token batch", rows, t);
+
+  auto fill = [&](auto zero, auto one) {
+    using T = decltype(zero);
+    auto valid = reinterpret_cast<T*>(mInputBufferInfos[validIdx].data);
+    for (size_t i = 0; i < t; i++) {
+      valid[i] = (i >= left && i < t - right) ? one : zero;
+    }
+    auto select = reinterpret_cast<T*>(mInputBufferInfos[selectIdx].data);
+    std::fill(select, select + rows * cols, zero);
+    const size_t end = t - right;
+    for (size_t j = 0; j < cols; j++) {
+      select[(end + j) * cols + j] = one;
+    }
+  };
+  const auto type = method_meta.input_tensor_meta(validIdx)->scalar_type();
+  if (type == executorch::aten::ScalarType::Float) {
+    fill(0.0f, 1.0f);
+  } else if (type == executorch::aten::ScalarType::Half) {
+    fill(static_cast<__fp16>(0.0f), static_cast<__fp16>(1.0f));
+  } else {
+    ET_LOG(Fatal, "Unsupported conv input type %d", static_cast<int>(type));
   }
 }
 
