+};
+
+// Holds MediaTek's FAST_SINGLE_ANSWER performance lock only while the NPU is executing.
+//
+// ScopePerformancer above renews the lock every second for as long as it lives, and the
+// backend used to create one per compiled chunk at load, so a loaded model kept the power
+// HAL's boost scenario for the whole session. For a foreground app that scenario raised
+// every thread of the process to uclamp.min 1024, and under that clamp the scheduler
+// stacked a CPU decode's XNNPACK pool onto two cores: measured on a Dimensity 9400, seven
+// threads spending more time queued than running, 50 to 57 ms a decode step against 36
+// with no lock held. The lock is worth having where the APU works (a 128-token prefill
+// call took about 500 ms with it and 700 ms without), so it is kept for exactly that.
+//
+// One per process, because the lock is a process-level request, and a multi-chunk model
+// runs its chunks back to back: one holder spanning them avoids a HAL call per chunk.
+class NpuActivityPerformanceLock {
+ public:
+  static NpuActivityPerformanceLock& Get() {
+    static NpuActivityPerformanceLock instance;
+    return instance;
+  }
+
+  // RAII marker for one NPU execution.
+  class Scope {
+   public:
+    Scope() { NpuActivityPerformanceLock::Get().Begin(); }
+    ~Scope() { NpuActivityPerformanceLock::Get().End(); }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+  };
+
+ private:
+  // How long the APU may sit idle before the lock goes. Longer than the gap between the
+  // chunks of one prefill batch and between batches, which is CPU bookkeeping measured in
+  // single milliseconds; far shorter than any CPU work that follows a prefill.
+  static constexpr std::chrono::milliseconds kIdleRelease{100};
+  // What each request asks the HAL for, renewed well inside it.
+  static constexpr uint32_t kLockMs = 2000;
+  static constexpr std::chrono::milliseconds kRenewEvery{1000};
+
+  NpuActivityPerformanceLock() : mLib(ApuWareUtilsLib::GetInstance()) {
+    if (mLib.mEnable) mThread = std::thread(&NpuActivityPerformanceLock::Run, this);
+  }
+
+  // A process-lifetime static; the worker is detached at exit rather than joined, since
+  // joining in a static destructor can deadlock against other teardown.
+  ~NpuActivityPerformanceLock() {
+    {
+      std::lock_guard<std::mutex> guard(mMutex);
+      mStop = true;
+    }
+    mCond.notify_one();
+    if (mThread.joinable()) mThread.detach();
+  }
+
+  void Begin() {
+    if (!mLib.mEnable) return;
+    std::lock_guard<std::mutex> guard(mMutex);
+    ++mActive;
+    if (!mHeld) {
+      // Taken here rather than by the worker, so the first execution of a prefill already
+      // runs boosted instead of waiting for a thread to wake.
+      mHandle = mLib.acquirePerformanceLock(mHandle, FAST_SINGLE_ANSWER_MODE, kLockMs);
+      mLastRenew = std::chrono::steady_clock::now();
+      mHeld = true;
+      mCond.notify_one();
+    }
+  }
+
+  void End() {
+    if (!mLib.mEnable) return;
+    std::lock_guard<std::mutex> guard(mMutex);
+    if (mActive > 0) --mActive;
+    mLastEnd = std::chrono::steady_clock::now();
+    mCond.notify_one();
+  }
+
+  void Run() {
+    std::unique_lock<std::mutex> lock(mMutex);
+    while (!mStop) {
+      mCond.wait(lock, [this] { return mStop || mHeld; });
+      while (!mStop && mHeld) {
+        const auto now = std::chrono::steady_clock::now();
+        if (mActive == 0 && now - mLastEnd >= kIdleRelease) {
+          mLib.releasePerformanceLock(mHandle);
+          mHandle = 0;
+          mHeld = false;
+          break;
+        }
+        if (now - mLastRenew >= kRenewEvery) {
+          mHandle = mLib.acquirePerformanceLock(mHandle, FAST_SINGLE_ANSWER_MODE, kLockMs);
+          mLastRenew = now;
+        }
+        mCond.wait_for(lock, mActive == 0 ? kIdleRelease : kRenewEvery);
+      }
+    }
+  }
+
+  ApuWareUtilsLib& mLib;
+  std::mutex mMutex;
+  std::condition_variable mCond;
+  std::thread mThread;
+  int mActive = 0;
+  bool mHeld = false;
+  bool mStop = false;
+  int32_t mHandle = 0;
+  std::chrono::steady_clock::time_point mLastEnd{};
+  std::chrono::steady_clock::time_point mLastRenew{};
+};
