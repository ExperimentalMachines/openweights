+bool LlamaModelChunk::DetectConvInputs(const size_t firstIndex) {
+  // [1, t, 1] then [1, t + s, s]: nothing else a llama chunk takes after its rotary
+  // embedding looks like this, since a cache is 4-D.
+  const auto method_meta = GetModelMethod().method_meta();
+  if (firstIndex + 1 >= method_meta.num_inputs()) {
+    return false;
+  }
+  const auto valid = method_meta.input_tensor_meta(firstIndex);
+  const auto select = method_meta.input_tensor_meta(firstIndex + 1);
+  if (!valid.ok() || !select.ok()) {
+    return false;
+  }
+  const auto v = valid->sizes();
+  const auto s = select->sizes();
+  return v.size() == 3 && v[0] == 1 && v[2] == 1 && s.size() == 3 && s[0] == 1 &&
+      s[2] >= 1 && s[1] == v[1] + s[2];
 }
 
